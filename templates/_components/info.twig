{% set panelEntry = panelContentEntry|default(null) %}
{% set panelValue = panelEntry ? attribute(panelEntry, 'infoText') : null %}
{% set panelPlainText = panelValue ? (panelValue|striptags|trim) : '' %}
{% set infoImage = panelEntry ? attribute(panelEntry, 'infoImage').one() : null %}
{% set imageAlt = infoImage and infoImage.alt ? infoImage.alt|trim : '' %}

<div class="info-content{% if infoImage %} info-content--has-image{% endif %}">
  <div class="info-text panel-rich-text">
    {% if panelPlainText %}
      {{ panelValue }}
    {% else %}
      <p>Add formatted biography and contact information in Home → Info.</p>
    {% endif %}
  </div>

  {% if infoImage %}
    <figure class="info-content__figure">
      <img
        class="info-content__image"
        src="{{ infoImage.url|e('html_attr') }}"
        alt="{{ imageAlt|e('html_attr') }}"
        width="{{ infoImage.width }}"
        height="{{ infoImage.height }}"
        loading="lazy"
        decoding="async"
      >
    </figure>
  {% endif %}
</div>
