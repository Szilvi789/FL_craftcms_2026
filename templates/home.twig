{% extends "_layouts/main.twig" %}

{% set homeEntry = null %}
{% if currentUser %}
  {% set homeEntry = craft.entries()
    .section('homepage')
    .site(currentSite)
    .status(null)
    .draftOf(false)
    .savedDraftsOnly()
    .draftCreator(currentUser)
    .orderBy('elements.dateUpdated DESC')
    .one() %}
{% endif %}
{% if not homeEntry %}
  {% set homeEntry = craft.entries().section('homepage').site(currentSite).one() %}
{% endif %}

{% block barbaNamespace %}home{% endblock %}
{% block navTheme %}dynamic-inverse{% endblock %}
{% block navBehavior %}home-reveal{% endblock %}

{% block content %}
{% set projects = craft.entries().section('projects').site(currentSite).orderBy('projectYear desc, title asc').all() %}
{% set projectTiles = [] %}
{% for project in projects %}
  {% set mainMedia = project.heroImage.one() %}
  {% if mainMedia %}
    {% set projectTiles = projectTiles|merge([{
      project: project,
      media: mainMedia
    }]) %}
  {% endif %}
{% endfor %}
{% set coverHoleTop = homeEntry and homeEntry.coverHoleTop ? homeEntry.coverHoleTop : '12vh' %}
{% set coverHoleLeft = homeEntry and homeEntry.coverHoleLeft ? homeEntry.coverHoleLeft : '55vw' %}
{% set coverHoleSizeWidth = homeEntry and homeEntry.coverHoleSizeWidth ? homeEntry.coverHoleSizeWidth : '18vw' %}

<section
  class="home-hero"
  style="--home-cover-hole-top: {{ coverHoleTop|e('html_attr') }}; --home-cover-hole-left: {{ coverHoleLeft|e('html_attr') }}; --home-cover-hole-size: {{ coverHoleSizeWidth|e('html_attr') }};"
>
  <div
    class="home-hero__cover"
    aria-hidden="true"
  >
    <div class="home-hero__hole">
      <span class="home-hero__hole-mask home-hero__hole-mask--top"></span>
      <span class="home-hero__hole-mask home-hero__hole-mask--right"></span>
      <span class="home-hero__hole-mask home-hero__hole-mask--bottom"></span>
      <span class="home-hero__hole-mask home-hero__hole-mask--left"></span>
    </div>
  </div>

  <div class="intro-title">
    <h1>{{ siteName }}</h1>
    <h2>Photography</h2>
  </div>

  <div class="home-loader" data-home-loader role="status" aria-live="polite" aria-label="Loading photographs">
    <span class="home-loader__counter" data-home-loader-counter>0</span>
  </div>
</section>

{% if projectTiles %}
  <section class="home-selected-work" aria-label="Projects" data-home-selected-work>
    <div class="home-selected-work__background-name" aria-hidden="true">{{ siteName }}</div>
    <div
      class="home-selected-work__viewport"
      data-home-infinite-grid
    >
      <div class="home-selected-work__container" data-home-infinite-container>
        <div class="home-selected-work__scene" data-home-infinite-grid-scene>
          {% for tile in projectTiles %}
            <div class="home-selected-work__cell" data-home-grid-cell>
              {% include "_components/home/homeProjectCard.twig" with {
                project: tile.project,
                mainMedia: tile.media
              } only %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}
{% endblock %}
