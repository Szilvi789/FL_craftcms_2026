<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
{% set transitionHomeEntry = null %}
{% if currentUser %}
  {% set transitionHomeEntry = craft.entries()
    .section('homepage')
    .site(currentSite)
    .status(null)
    .draftOf(false)
    .savedDraftsOnly()
    .draftCreator(currentUser)
    .orderBy('elements.dateUpdated DESC')
    .one() %}
{% endif %}
{% if not transitionHomeEntry %}
  {% set transitionHomeEntry = craft.entries().section('homepage').site(currentSite).one() %}
{% endif %}
{% set transitionHoleTop = transitionHomeEntry and transitionHomeEntry.coverHoleTop ? transitionHomeEntry.coverHoleTop : '12vh' %}
{% set transitionHoleLeft = transitionHomeEntry and transitionHomeEntry.coverHoleLeft ? transitionHomeEntry.coverHoleLeft : '55vw' %}
{% set transitionHoleSize = transitionHomeEntry and transitionHomeEntry.coverHoleSizeWidth ? transitionHomeEntry.coverHoleSizeWidth : '18vw' %}
{% set displayTypefaceValue = transitionHomeEntry ? attribute(transitionHomeEntry, 'displayTypeface') : null %}
{% set bodyTypefaceValue = transitionHomeEntry ? attribute(transitionHomeEntry, 'bodyTypeface') : null %}
{% set displayTypefaceKey = displayTypefaceValue ? (displayTypefaceValue.value ?? displayTypefaceValue) : 'leagueSpartan' %}
{% set bodyTypefaceKey = bodyTypefaceValue ? (bodyTypefaceValue.value ?? bodyTypefaceValue) : 'instrumentSans' %}
{% set displayTypefaceMap = {
  leagueSpartan: "'League Spartan', 'Arial Black', sans-serif",
  instrumentSans: "'Instrument Sans', 'Helvetica Neue', sans-serif",
  manrope: "'Manrope', 'Helvetica Neue', sans-serif"
} %}
{% set bodyTypefaceMap = {
  instrumentSans: "'Instrument Sans', 'Helvetica Neue', sans-serif",
  sourceSans3: "'Source Sans 3', 'Helvetica Neue', sans-serif",
  manrope: "'Manrope', 'Helvetica Neue', sans-serif"
} %}
{% set displayTypefaceStack = displayTypefaceMap[displayTypefaceKey] ?? displayTypefaceMap.leagueSpartan %}
{% set bodyTypefaceStack = bodyTypefaceMap[bodyTypefaceKey] ?? bodyTypefaceMap.instrumentSans %}
{% set introTitleMinimumSizeMap = {
  leagueSpartan: '3rem',
  instrumentSans: '3rem',
  manrope: '2.5rem'
} %}
{% set introTitleMinimumSize = introTitleMinimumSizeMap[displayTypefaceKey] ?? introTitleMinimumSizeMap.leagueSpartan %}
{% set barbaNamespace %}{% block barbaNamespace %}default{% endblock %}{% endset %}
{% set navTheme %}{% block navTheme %}black{% endblock %}{% endset %}
{% set navLayout %}{% block navLayout %}full{% endblock %}{% endset %}
{% set navBehavior %}{% block navBehavior %}static{% endblock %}{% endset %}
{% set navBackHref %}{% block navBackHref %}{% endblock %}{% endset %}
{% set navContactHref %}{% block navContactHref %}{% endblock %}{% endset %}
<head>
    <meta charset="utf-8">
    <title>{% block title %}{{ siteName }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/assets/favicon/FL_Favicon.png">
    <link rel="stylesheet" href="/css/base/variables.css?v=3">
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/base/base.css?v=10">
    <link rel="stylesheet" href="/css/base/typography.css?v=5">
    <link rel="stylesheet" href="/css/base/reflowLetters.css?v=3">
    <link rel="stylesheet" href="/css/nav/nav.css?v=33">
    <link rel="stylesheet" href="/css/info/info.css?v=5">
    <link rel="stylesheet" href="/css/contact/contact.css?v=13">
    <link rel="stylesheet" href="/css/legal/legal.css?v=8">
    <link rel="stylesheet" href="/css/transition/transition.css?v=13">
    <link rel="stylesheet" href="/css/home/home.css?v=40">
    <link rel="stylesheet" href="/css/404/404.css?v=3">
    <link rel="stylesheet" href="/css/project/project.css?v=11">
</head>
<body
  data-barba="wrapper"
  style="--font-display: {{ displayTypefaceStack|e('html_attr') }}; --font-body: {{ bodyTypefaceStack|e('html_attr') }}; --home-intro-title-min-size: {{ introTitleMinimumSize|e('html_attr') }}; --page-transition-hole-top: {{ transitionHoleTop|e('html_attr') }}; --page-transition-hole-left: {{ transitionHoleLeft|e('html_attr') }}; --page-transition-hole-size: {{ transitionHoleSize|e('html_attr') }}; --page-transition-fill: #ffffff;"
>
    <div
      class="site-page-shell"
      data-barba="container"
      data-barba-namespace="{{ barbaNamespace|trim ?: 'default' }}"
    >
      {% include "_components/shared/nav/nav.twig" with {
        navLayout: navLayout|trim ?: 'full',
        navTheme: navTheme|trim ?: 'black',
        navBehavior: navBehavior|trim ?: 'static',
        navBackHref: navBackHref|trim,
        navContactHref: navContactHref|trim,
        panelContentEntry: transitionHomeEntry
      } %}

      <main class="site-main">
          {% block content %}{% endblock %}
      </main>
    </div>

    <div class="page-transition">
      <span class="page-transition__shade" aria-hidden="true"></span>
      <div class="page-transition__window" aria-hidden="true">
        <span class="page-transition__mask page-transition__mask--top"></span>
        <span class="page-transition__mask page-transition__mask--right"></span>
        <span class="page-transition__mask page-transition__mask--bottom"></span>
        <span class="page-transition__mask page-transition__mask--left"></span>
      </div>
      <div
        class="page-transition__loader"
        data-page-transition-loader
        role="progressbar"
        aria-label="Loading homepage"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext="0 percent"
        hidden
      >
        <span class="page-transition__loader-counter" data-page-transition-loader-counter>0</span>
        <span class="page-transition__loader-unit" aria-hidden="true">%</span>
      </div>
    </div>

    <div class="site-cursor" aria-hidden="true"></div>

    <script src="/js/vendor/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@barba/core"></script>
    <script type="module" src="/js/app.js?v=97"></script>
</body>
</html>
